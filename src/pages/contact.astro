---
import Main from "../layouts/MainLayout.astro";
import { Icon } from "astro-icon/components";
import YukinaConfig from "../../yukina.config";

const { email, linkedin } = YukinaConfig.contact;
---

<Main
  title="Contact"
  subTitle="The fastest way to reach me is email. I'm always happy to talk about hardware, embedded systems, or new opportunities."
>
  <div class="contact-list">
    <a class="contact-row" href={`mailto:${email}`}>
      <span class="label">Email</span>
      <span class="value">{email}</span>
    </a>

    <a
      class="contact-row"
      href={linkedin}
      target="_blank"
      rel="noopener noreferrer"
    >
      <span class="label">LinkedIn</span>
      <span class="value">{linkedin.replace("https://www.", "")} ↗</span>
    </a>

    {
      YukinaConfig.socialLinks.map((item) => (
        <a
          class="contact-row"
          href={item.link}
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="label">
            <Icon name={item.icon} size={18} />
          </span>
          <span class="value">{item.link.replace("https://", "")} ↗</span>
        </a>
      ))
    }
  </div>
</Main>

<style>
  .contact-list {
    @apply flex flex-col;
    border-top: 1px solid var(--border-color);
  }

  .contact-row {
    @apply flex flex-row items-center gap-6 py-5 transition-colors;
    border-bottom: 1px solid var(--border-color);
  }

  .label {
    @apply flex w-28 shrink-0 items-center text-xs uppercase tracking-widest text-[var(--text-color-lighten)];
  }

  .value {
    @apply break-all text-base text-[var(--text-color)] transition-colors;
  }

  .contact-row:hover .value {
    color: var(--primary-color);
  }
</style>
