---
import { getEntry, render } from "astro:content";
import Main from "../layouts/MainLayout.astro";
import Markdown from "../components/Markdown.astro";
import YukinaConfig from "../../yukina.config";

const aboutPost = await getEntry("specs", "about");
const { Content } = await render(aboutPost!);
---

<Main title="About" showHeader={false}>
  <div class="about-head onload-animation">
    <img
      class="about-avatar"
      src={YukinaConfig.avatarUrl}
      alt={YukinaConfig.username}
    />
    <div>
      <h1 class="about-title font-display">About</h1>
      <p class="about-sign">{YukinaConfig.sign}</p>
    </div>
  </div>

  <div class="article onload-animation">
    <Markdown>
      <Content />
    </Markdown>
  </div>
</Main>

<style>
  .about-head {
    @apply mb-12 flex flex-row items-center gap-6;
  }

  .about-avatar {
    @apply h-24 w-24 shrink-0 rounded-full object-cover;
    border: 1px solid var(--border-color);
  }

  .about-title {
    @apply text-5xl leading-none text-[var(--text-color)];
  }

  .about-sign {
    @apply mt-2 text-sm text-[var(--text-color-lighten)];
  }
</style>
