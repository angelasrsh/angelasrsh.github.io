---
import { Icon } from "astro-icon/components";
import YukinaConfig from "../../yukina.config";
import { i18n } from "../locales/translation";
---

<footer class="footer">
  <div class="footer-top">
    <div class="footer-brand">
      <a href="/" class="footer-name font-display">{YukinaConfig.username}</a>
      <p class="footer-tag">{YukinaConfig.heroEyebrow}</p>
    </div>

    <nav class="footer-nav">
      {
        YukinaConfig.navigators.map((nav) => (
          <a href={nav.href}>{i18n(nav.nameKey)}</a>
        ))
      }
    </nav>

    <ul class="footer-socials">
      {
        YukinaConfig.socialLinks.map((item) => (
          <li>
            <a href={item.link} target="_blank" rel="noopener noreferrer">
              <Icon name={item.icon} size={20} />
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="footer-bottom">
    <p>© {new Date().getFullYear()} {YukinaConfig.username}</p>
    <p>
      <a href="/rss.xml">RSS</a>
      <span class="sep">·</span>
      <a href="/archive">Archive</a>
      <span class="sep">·</span>
      <a href="https://astro.build/" target="_blank" rel="noopener noreferrer">
        Built with Astro
      </a>
    </p>
  </div>
</footer>

<style>
  .footer {
    @apply mt-24 pt-10 lg:mt-32;
    border-top: 1px solid var(--border-color);
  }

  .footer-top {
    @apply flex flex-col gap-8 md:flex-row md:items-start md:justify-between;
  }

  .footer-name {
    @apply text-2xl text-[var(--text-color)] transition-colors;
  }

  .footer-name:hover {
    color: var(--primary-color);
  }

  .footer-tag {
    @apply mt-1 text-xs text-[var(--text-color-lighten)];
  }

  .footer-nav {
    @apply flex flex-row flex-wrap gap-x-6 gap-y-2;
  }

  .footer-nav a {
    @apply text-sm text-[var(--text-color-lighten)] transition-colors;
  }

  .footer-nav a:hover {
    color: var(--primary-color);
  }

  .footer-socials {
    @apply flex flex-row items-center gap-4;
  }

  .footer-socials a {
    @apply text-[var(--text-color-lighten)] transition-colors;
  }

  .footer-socials a:hover {
    color: var(--primary-color);
  }

  .footer-bottom {
    @apply mt-10 flex flex-col gap-2 pt-6 text-xs text-[var(--text-color-lighten)] sm:flex-row sm:items-center sm:justify-between;
    border-top: 1px solid var(--border-color);
  }

  .footer-bottom a {
    @apply transition-colors;
  }

  .footer-bottom a:hover {
    color: var(--primary-color);
  }

  .sep {
    @apply px-2 opacity-60;
  }
</style>
