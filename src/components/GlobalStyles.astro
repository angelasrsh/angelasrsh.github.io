---
import "../styles/animations.css";
import "../styles/scrollbar.css";
import "../styles/transitions.css";
import "../styles/searchbar.css";
import "overlayscrollbars/overlayscrollbars.css";
---

<style is:global>
  :root {
    /* Ube purple. Everything else is derived from this hue. */
    --hue: 302;

    --primary-color: oklch(52% 0.11 var(--hue));
    --primary-color-lighten: oklch(95.5% 0.02 var(--hue));
    --primary-color-hover: oklch(96.5% 0.014 var(--hue));
    --primary-color-transparent: oklch(52% 0.11 var(--hue) / 10%);

    --text-color: oklch(22% 0.008 var(--hue));
    --text-color-lighten: oklch(52% 0.012 var(--hue));

    --card-color: oklch(100% 0 0);
    --card-color-lighten: oklch(98% 0.005 var(--hue));
    --card-color-transparent: oklch(100% 0 0 / 80%);
    --background-color: oklch(99% 0.004 var(--hue));

    --border-color: oklch(91% 0.008 var(--hue));
    --border-color-strong: oklch(82% 0.014 var(--hue));

    --brand-font: "Bodoni Moda", "Didot", "Iowan Old Style", Georgia, serif;
    --serif-font: var(--brand-font);
    --primary-font:
      "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    --code-font: "JetBrains Mono", "Fira Code", ui-monospace, monospace;

    /* Narrower measure than the stock theme - minimal layouts read better tight. */
    --page-width-lg: 880px;
    --page-width-xl: 1100px;

    --title-font: var(--brand-font);
    --title-color: var(--text-color);
    --subtitle-font: var(--primary-font);
    --subtitle-color: var(--text-color-lighten);

    --onload-animation-delay: 60ms;
    --onload-animation-interval: 70ms;
  }

  :root.dark {
    --primary-color: oklch(80% 0.105 var(--hue));
    --primary-color-lighten: oklch(32% 0.045 var(--hue));
    --primary-color-hover: oklch(26% 0.03 var(--hue));
    --primary-color-transparent: oklch(80% 0.105 var(--hue) / 14%);

    --text-color: oklch(94% 0.005 var(--hue));
    --text-color-lighten: oklch(70% 0.012 var(--hue));

    --card-color: oklch(20% 0.014 var(--hue));
    --card-color-lighten: oklch(24% 0.018 var(--hue));
    --card-color-transparent: oklch(20% 0.014 var(--hue) / 80%);
    --background-color: oklch(16% 0.012 var(--hue));

    --border-color: oklch(30% 0.016 var(--hue));
    --border-color-strong: oklch(40% 0.022 var(--hue));
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    font-family: var(--primary-font);
    color: var(--text-color);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  ::selection {
    background-color: var(--primary-color-lighten);
    color: var(--primary-color);
  }

  .swup-progress-bar {
    height: 2px;
    background-color: var(--primary-color);
  }

  /* Shared type scale for the serif display face. Bodoni Moda's contrast
     reads thin at 400, so lean on 500 for headings and the brand name. */
  .font-display {
    font-family: var(--brand-font);
    font-weight: 500;
    letter-spacing: 0;
  }

  /* Small uppercase label used above each home-page section. */
  .eyebrow {
    font-family: var(--primary-font);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-color-lighten);
  }
</style>
