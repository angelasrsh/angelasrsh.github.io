---
import YukinaConfig from "../../yukina.config";
import { i18n } from "../locales/translation";

import { Icon } from "astro-icon/components";
import SearchBar from "./SearchBar.svelte";
import MobileSearchBar from "./MobileSearchBar.svelte";
import "astro-pagefind";

const navCount = YukinaConfig.navigators.length;
const currentPath = Astro.url.pathname;

/** A link is active when it matches exactly, or is the section root of the path. */
const isActive = (href: string) => {
  if (href === "/") return currentPath === "/";
  if (!href.startsWith("/")) return false;
  return currentPath === href || currentPath.startsWith(`${href}/`);
};
---

<nav class="nav" id="nav">
  <div class="nav-inner">
    <!-- Mobile: menu button + centered brand -->
    <div class="brand-sm">
      <button
        id="menu-switcher"
        type="button"
        class="h-[40px] w-[44px] content-center"
        aria-label="Toggle menu"
      >
        <Icon
          id="menu-icon-closed"
          size={22}
          name="line-md:close-to-menu-transition"
          class="mx-auto hidden"
        />
        <Icon
          id="menu-icon-opened"
          size={22}
          name="line-md:menu-to-close-transition"
          class="mx-auto hidden"
        />
      </button>
      <a class="title font-display" href="/">
        {YukinaConfig.brandTitle}
      </a>
    </div>

    <!-- Desktop: brand left -->
    <a class="brand-lg font-display" href="/">
      {YukinaConfig.brandTitle}
    </a>

    <!-- Desktop: links right -->
    <div class="menu">
      {
        YukinaConfig.navigators.map((nav) => (
          <a
            href={nav.href}
            class:list={["menu-link", isActive(nav.href) && "is-active"]}
          >
            {i18n(nav.nameKey)}
          </a>
        ))
      }
    </div>

    <div class="toolbar">
      <div class="lg:hidden">
        <MobileSearchBar client:only="svelte" />
      </div>
      <div class="hidden lg:block">
        <SearchBar client:only="svelte" />
      </div>
      <button type="button" id="theme-switcher" aria-label="Toggle theme">
        <Icon
          id="theme-icon-light"
          name="line-md:moon-alt-to-sunny-outline-loop-transition"
          size={20}
          class="hidden"
        />
        <Icon
          id="theme-icon-dark"
          name="line-md:sunny-outline-to-moon-alt-loop-transition"
          size={20}
          class="hidden"
        />
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="px-2 transition-all">
    <ul
      id="mobile-menu-nav"
      class="mobile-menu-nav mobile-menu-nav-closed flex flex-col overflow-hidden transition-all duration-300"
    >
      {
        YukinaConfig.navigators.map((nav) => (
          <li>
            <a
              href={nav.href}
              class:list={[
                "mobile-nav-item",
                isActive(nav.href) && "is-active",
              ]}
            >
              <span>{i18n(nav.nameKey)}</span>
              <Icon
                name="cuida:caret-right-outline"
                class="text-[var(--text-color-lighten)]"
              />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</nav>

<style define:vars={{ navCount }}>
  .nav {
    @apply fixed left-0 top-0 z-30 flex w-full select-none flex-col px-6 transition-all duration-300 lg:px-8;
    background-color: var(--card-color-transparent);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid transparent;
  }

  /* Hairline appears only once the page has scrolled. */
  .nav.is-scrolled {
    border-bottom-color: var(--border-color);
  }

  .nav-inner {
    @apply mx-auto flex h-[4rem] w-full items-center justify-between lg:h-[4.5rem];
    max-width: var(--page-width-xl);
  }

  .brand-sm {
    @apply relative flex w-full flex-row items-center justify-between lg:hidden;
  }

  .brand-sm > .title {
    @apply absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 truncate text-xl text-[var(--text-color)];
  }

  .brand-sm button {
    @apply flex h-[40px] w-[40px] flex-row items-center rounded-md text-[var(--text-color)] transition-all;
    @apply hover:text-[var(--primary-color)];
  }

  .brand-lg {
    @apply hidden text-2xl text-[var(--text-color)] transition-colors lg:block;
    @apply hover:text-[var(--primary-color)];
  }

  .menu {
    @apply hidden items-center gap-1 lg:flex;
  }

  .menu-link {
    @apply relative rounded-md px-3 py-2 text-sm font-normal text-[var(--text-color-lighten)] transition-colors;
    font-family: var(--primary-font);
  }

  .menu-link:hover {
    @apply text-[var(--text-color)];
  }

  /* Thin underline marks the section you're in. */
  .menu-link.is-active {
    @apply text-[var(--text-color)];
  }

  .menu-link.is-active::after {
    content: "";
    @apply absolute bottom-1 left-3 right-3 h-px;
    background-color: var(--primary-color);
  }

  .toolbar {
    @apply flex flex-row items-center justify-end gap-1;
  }

  .toolbar button {
    @apply flex h-9 w-9 items-center justify-center rounded-md text-[var(--text-color-lighten)] transition-colors;
    @apply hover:text-[var(--primary-color)];
  }

  .mobile-menu-nav-closed {
    @apply h-0 opacity-0;
  }

  .mobile-menu-nav-opened {
    @apply opacity-100;
    height: calc(var(--navCount) * 48px + 12px);
  }

  .mobile-nav-item {
    @apply flex flex-row items-center justify-between px-2 py-3 text-base text-[var(--text-color-lighten)] transition-colors;
    font-family: var(--primary-font);
  }

  .mobile-nav-item.is-active,
  .mobile-nav-item:hover {
    @apply text-[var(--primary-color)];
  }
</style>

<script>
  /**
   * Reinitializes an SVG icon by cloning it and replacing the original icon with the clone.
   *
   * @param icon - The SVG element to be reinitialized.
   * @returns The cloned SVG element that replaced the original.
   */
  const reinitializeIcon = (icon: SVGElement) => {
    const cloned = icon.cloneNode(true) as SVGElement;
    icon.parentNode?.replaceChild(cloned, icon);
    return cloned;
  };

  const setupNav = () => {
    // get elements
    const menuSwitcher = document.getElementById(
      "menu-switcher",
    ) as HTMLButtonElement | null;
    const mobileMenuNav = document.getElementById(
      "mobile-menu-nav",
    ) as HTMLUListElement | null;
    const mobileMenuNavItems =
      document.getElementsByClassName("mobile-nav-item");
    let menuIconClosed = document.getElementById(
      "menu-icon-closed",
    ) as any as SVGElement | null;
    let menuIconOpened = document.getElementById(
      "menu-icon-opened",
    ) as any as SVGElement | null;

    if (!menuSwitcher || !mobileMenuNav || !menuIconClosed || !menuIconOpened)
      return;

    // menu state
    let isMenuOpen = false;

    // switch menu open / close
    const switchMenuState = () => {
      menuIconClosed!.style.display = isMenuOpen ? "block" : "none";
      menuIconOpened!.style.display = !isMenuOpen ? "block" : "none";
      if (isMenuOpen) menuIconClosed = reinitializeIcon(menuIconClosed!);
      else menuIconOpened = reinitializeIcon(menuIconOpened!);
      if (isMenuOpen) {
        mobileMenuNav.classList.replace(
          "mobile-menu-nav-opened",
          "mobile-menu-nav-closed",
        );
      } else {
        mobileMenuNav.classList.replace(
          "mobile-menu-nav-closed",
          "mobile-menu-nav-opened",
        );
      }
      isMenuOpen = !isMenuOpen;
    };

    // click menu item then close menu
    menuSwitcher.addEventListener("click", switchMenuState);
    for (let i = 0; i < mobileMenuNavItems.length; ++i) {
      mobileMenuNavItems.item(i)?.addEventListener("click", switchMenuState);
    }
    // click other elements then close menu
    document.addEventListener("click", (event) => {
      if (
        !menuSwitcher.contains(event.target as any) &&
        !mobileMenuNav.contains(event.target as any) &&
        isMenuOpen
      ) {
        switchMenuState();
      }
    });

    menuIconClosed.style.display = "block";
  };

  const setupTheme = () => {
    const themeSwitcher = document.getElementById(
      "theme-switcher",
    ) as HTMLButtonElement | null;
    let themeIconLight = document.getElementById(
      "theme-icon-light",
    ) as any as SVGElement | null;
    let themeIconDark = document.getElementById(
      "theme-icon-dark",
    ) as any as SVGElement | null;

    if (!themeSwitcher || !themeIconLight || !themeIconDark) return;

    let currentTheme = localStorage.getItem("theme") || "light";

    const setTheme = (theme: string) => {
      document.documentElement.setAttribute("data-theme", theme);
      localStorage.setItem("theme", theme);
      currentTheme = theme;

      themeIconDark!.style.display = theme === "dark" ? "block" : "none";
      themeIconLight!.style.display = theme === "light" ? "block" : "none";

      if (theme === "dark") themeIconDark = reinitializeIcon(themeIconDark!);
      else themeIconLight = reinitializeIcon(themeIconLight!);

      document.documentElement.classList.toggle("dark", theme === "dark");
    };

    themeSwitcher.addEventListener("click", () => {
      setTheme(currentTheme === "light" ? "dark" : "light");
    });

    setTheme(currentTheme);
  };

  // Hairline border once scrolled away from the top. The old theme measured a
  // banner element here; there is no banner any more, so key off scrollY alone.
  const setupScrollState = () => {
    const navBarElement = document.getElementById("nav");
    if (!navBarElement) return;
    const onScroll = () => {
      navBarElement.classList.toggle("is-scrolled", window.scrollY > 8);
    };
    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();
  };

  const init = () => {
    setupNav();
    setupTheme();
    setupScrollState();
  };

  document.addEventListener("DOMContentLoaded", init);
  if (document.readyState !== "loading") init();
</script>

<script is:inline>
  // load pagefind
  async function loadPagefind() {
    try {
      const pagefind = await import("/pagefind/pagefind.js");
      await pagefind.options({
        excerptLength: 20,
      });
      pagefind.init();
      window.pagefind = pagefind;
      pagefind.search("");
    } catch (e) {
      // Pagefind only exists after a production build; ignore in dev.
    }
  }
  loadPagefind();
</script>
